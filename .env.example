DJANGO_DEBUG=False
DJANGO_SECRET_KEY=your-strong-secret-key
DJANGO_ALLOWED_HOSTS=your-domain.com,www.your-domain.com
DJANGO_SITE_URL=https://your-domain.com
# Signup defaults (productionda odatda hammasi False bo'ladi)
SIGNUP_AUTO_ACTIVATE=False
SIGNUP_AUTO_STAFF=False
SIGNUP_AUTO_SUPERUSER=False
CSRF_TRUSTED_ORIGINS=https://your-domain.com,https://www.your-domain.com

# Database
DJANGO_DB_ENGINE=postgres
POSTGRES_DB=portfolio_db
POSTGRES_USER=portfolio_user
POSTGRES_PASSWORD=strong-db-password
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_CONN_MAX_AGE=60

# Security
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000
AXES_FAILURE_LIMIT=5
AXES_COOLOFF_TIME=1

# Storage
USE_S3=False
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=us-east-1
AWS_S3_CUSTOM_DOMAIN=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Monitoring
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.2

# Contact notifications
CONTACT_NOTIFY_EMAIL=
CONTACT_THROTTLE_LIMIT=3
CONTACT_THROTTLE_WINDOW_SECONDS=600
GLOBAL_RATE_LIMIT_PER_MINUTE=120
LOGIN_RATE_LIMIT_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=600
PASSWORD_RESET_RATE_LIMIT_ATTEMPTS=3
PASSWORD_RESET_RATE_LIMIT_WINDOW_SECONDS=600
# Local devda haqiqiy email yubormaslik uchun:
# EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=
# Gmail SMTP uchun oddiy akkaunt paroli emas, 2FA yoqilgan akkauntdan App Password ishlating.
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=noreply@your-domain.com
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
WHATSAPP_NUMBER=
TELEGRAM_USERNAME=
HEALTHCHECK_ALERT_EMAIL=
HEALTHCHECK_ALERT_COOLDOWN_SECONDS=900

# reCAPTCHA (ixtiyoriy)
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
RECAPTCHA_MIN_SCORE=0.3

# Product links
CV_DOWNLOAD_URL=
BOOKING_EXTERNAL_URL=
BOOKING_SLOT_DAYS=7
BOOKING_SLOT_HOURS=10:00,13:00,16:00

# Newsletter campaign integration
NEWSLETTER_CAMPAIGN_PROVIDER=none
NEWSLETTER_CAMPAIGN_API_KEY=

# Celery + Redis (optional)
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=

# Backups
BACKUP_DIR=/var/backups/portfolio
BACKUP_RETENTION_DAYS=14
